# ContextIQ Collector — Example Environment Configuration
# Copy this file to .env.
# The collector only reads these variables. Do not put LLM or embedding
# provider credentials here — they belong in server/.env.

# Port the collector daemon listens on.
# Must match the COLLECTOR_PORT value set in server/.env (default: 8888).
# COLLECTOR_PORT=8888

# Allow scraping of any IP address including private/loopback ranges.
# Only enable this if you understand the SSRF implications.
# COLLECTOR_ALLOW_ANY_IP=true

# HTTP request/response logging (development only — disable in production)
# ENABLE_HTTP_LOGGER=true
# ENABLE_HTTP_LOGGER_TIMESTAMPS=true
