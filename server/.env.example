# ContextIQ Server — Example Environment Configuration
# Copy this file to .env and fill in the required values.
# Never commit .env — it is listed in .gitignore.

NODE_ENV=development

# ─── PORTS ────────────────────────────────────────────────────────────────────
SERVER_PORT=3001
COLLECTOR_PORT=8888

# ─── STORAGE ──────────────────────────────────────────────────────────────────
# Absolute path to the persistent storage root directory.
# The SQLite database, vector store, document JSONs, and model weights
# all live under subdirectories of STORAGE_DIR.
# Development default (relative to server/): ./storage
# Docker / production: set this to a host-mounted volume path.
STORAGE_DIR=/absolute/path/to/server/storage

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(32).toString('base64url') |> console.log"
# Or:            openssl rand -base64 32
JWT_SECRET=<generate-a-random-string-min-32-chars>

# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
SIG_KEY=<generate-a-random-hex-string-64-chars>
SIG_SALT=<generate-a-random-hex-string-64-chars>

# Optional: custom session duration (default: 30d)
# JWT_EXPIRY=30d

# ─── VECTOR DATABASE ──────────────────────────────────────────────────────────
# lancedb = embedded local file-based store (no server required, recommended)
# Other options: pgvector | chroma | qdrant | weaviate | milvus | pinecone | astra | zilliz
VECTOR_DB=lancedb

# ─── EMBEDDING ────────────────────────────────────────────────────────────────
# native = local CPU inference via @xenova/transformers (no API key required)
# Other options: openai | azure | ollama | gemini | cohere | voyageai | localai | lmstudio
EMBEDDING_ENGINE=native
EMBEDDING_MODEL_PREF=Xenova/all-MiniLM-L6-v2

# ─── LLM PROVIDER ─────────────────────────────────────────────────────────────
# groq = fast cloud inference (only external key needed for baseline setup)
# Other options: openai | anthropic | gemini | ollama | azure | deepseek | mistral | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_PREF=llama-3.1-8b-instant

# ─── LOCAL LLM (OPTIONAL) ─────────────────────────────────────────────────────
# Uncomment and configure to use a local Ollama instance instead of Groq.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_PATH=http://127.0.0.1:11434
# OLLAMA_MODEL_PREF=llama3

# ─── AUDIO (optional) ─────────────────────────────────────────────────────────
# local = built-in whisper-small model running on server (no API key required)
WHISPER_PROVIDER=local
TTS_PROVIDER=native
STT_PROVIDER=native

# ─── AUTHENTICATION (optional hardening) ──────────────────────────────────────
# Single-user password mode (set when not using multi-user mode via UI)
# AUTH_TOKEN=your-secure-password-here

# Enforce password complexity for multi-user mode accounts
# PASSWORDMINCHAR=8
# PASSWORDMAXCHAR=250
# PASSWORDLOWERCASE=1
# PASSWORDUPPERCASE=1
# PASSWORDNUMERIC=1
# PASSWORDSYMBOL=1

# ─── HTTPS (optional) ─────────────────────────────────────────────────────────
# ENABLE_HTTPS=true
# HTTPS_CERT_PATH=sslcert/cert.pem
# HTTPS_KEY_PATH=sslcert/key.pem

# ─── AGENT SEARCH ENGINES (optional — only if using web-search agent skill) ───
# AGENT_SERPAPI_API_KEY=
# AGENT_SEARXNG_API_URL=http://your-searxng-instance/search
# AGENT_TAVILY_API_KEY=
# AGENT_EXA_API_KEY=

# ─── TELEMETRY ────────────────────────────────────────────────────────────────
# Telemetry is permanently disabled in ContextIQ regardless of this value.
# This variable is retained for code compatibility only.
DISABLE_TELEMETRY=true

# ─── SCHEDULED JOBS (optional tuning) ────────────────────────────────────────
# SCHEDULED_JOB_MAX_CONCURRENT=1
# SCHEDULED_JOB_TIMEOUT_MS=300000

# ─── EMAIL / NODEMAILER PASSWORD RESET ─────────────────────────────────────────
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# APP_URL=http://localhost:3000

# ─── MEMORY EXTRACTION (optional tuning) ──────────────────────────────────────
# MEMORY_EXTRACTION_INTERVAL=3hr
